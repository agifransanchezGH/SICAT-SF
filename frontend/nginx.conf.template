# Procesado por la imagen nginx (envsubst): ${API_UPSTREAM} se toma del entorno.
server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $http_host;   # con puerto: la API ve el mismo origen que el navegador (CORS no aplica)
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Los bundles llevan un hash en el nombre (main-AB12CD.js): se pueden guardar un año.
    location ~* \.(?:js|css|woff2?|ttf|svg|png|jpg|webp|ico)$ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # index.html (y las rutas del router de Angular) se revalida siempre: así cada versión nueva
    # llega sin que haga falta forzar la recarga.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
