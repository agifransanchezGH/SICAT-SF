><mxCell id="e474" style="edgeStyle=entityRelationEdgeStyle;fontSize=12;html=1;endArrow=ERmandOne;startArrow=ERzeroToMany;endFill=0;startFill=0;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="r_categoria_caracteristica_id_categoria" target="r_categoria_id_categoria"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e475" style="edgeStyle=entityRelationEdgeStyle;fontSize=12;html=1;endArrow=ERmandOne;startArrow=ERzeroToMany;endFill=0;startFill=0;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="r_categoria_caracteristica_id_caracteristica" target="r_caracteristica_id_caracteristica"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e476" style="edgeStyle=entityRelationEdgeStyle;fontSize=12;html=1;endArrow=ERmandOne;startArrow=ERzeroToOne;endFill=0;startFill=0;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="r_circuito_id_oferta" target="r_oferta_id_oferta"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e477" style="edgeStyle=entityRelationEdgeStyle;fontSize=12;html=1;endArrow=ERzeroToOne;startArrow=ERzeroToMany;endFill=0;startFill=0;rounded=0;strokeColor=#888888;dashed=1;" edge="1" parent="1" source="r_circuito_id_lugar_partida" target="r_lugar_id_lugar"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e478" style="edgeStyle=entityRelationEdgeStyle;fontSize=12;html=1;endArrow=ERmandOne;startArrow=ERzeroToMany;endFill=0;startFill=0;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="r_circuito_parada_id_oferta" target="r_circuito_id_oferta"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e479" style="edgeStyle=entityRelationEdgeStyle;fontSize=12;html=1;endArrow=ERmandOne;startArrow=ERzeroToMany;endFill=0;startFill=0;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="r_circuito_parada_id_establecimiento" target="r_establecimiento_id_establecimiento"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="titulo" value="SICAT SF — Diagrama entidad-relación (modelo lógico, PostgreSQL + PostGIS)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1200" height="40" as="geometry"/></mxCell><mxCell id="subtitulo" value="Versión 3 — 23/10/2026 · Generado a partir de los 10 Excel del área de Turismo" style="text;html=1;fontSize=13;fontColor=#666666;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1200" height="26" as="geometry"/></mxCell><mxCell id="ley_t" value="Referencias" style="text;html=1;fontSize=14;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="2680" y="140" width="360" height="26" as="geometry"/></mxCell><mxCell id="ley_seg" value="" style="rounded=0;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="2680" y="174" width="26" height="18" as="geometry"/></mxCell><mxCell id="ley_seg_t" value="Esquema seguridad (usuarios y roles)" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2716" y="170" width="330" height="26" as="geometry"/></mxCell><mxCell id="ley_aud" value="" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="2680" y="202" width="26" height="18" as="geometry"/></mxCell><mxCell id="ley_aud_t" value="Esquema auditoria" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2716" y="198" width="330" height="26" as="geometry"/></mxCell><mxCell id="ley_core" value="" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="2680" y="230" width="26" height="18" as="geometry"/></mxCell><mxCell id="ley_core_t" value="Entidades y tablas puente (esquema sicat)" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2716" y="226" width="330" height="26" as="geometry"/></mxCell><mxCell id="ley_cat" value="" style="rounded=0;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="2680" y="258" width="26" height="18" as="geometry"/></mxCell><mxCell id="ley_cat_t" value="Catálogos (esquema sicat)" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2716" y="254" width="330" height="26" as="geometry"/></mxCell><mxCell id="ley_esp" value="" style="rounded=0;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="2680" y="286" width="26" height="18" as="geometry"/></mxCell><mxCell id="ley_esp_t" value="Especializaciones de OFERTA (esquema sicat)" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2716" y="282" width="330" height="26" as="geometry"/></mxCell><mxCell id="ley_l1" value="" style="endArrow=none;html=1;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2680" y="323" as="sourcePoint"/><mxPoint x="2706" y="323" as="targetPoint"/></mxGeometry></mxCell><mxCell id="ley_l1_t" value="Relación obligatoria (FK NOT NULL)" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2716" y="310" width="330" height="26" as="geometry"/></mxCell><mxCell id="ley_l2" value="" style="endArrow=none;html=1;strokeColor=#888888;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2680" y="351" as="sourcePoint"/><mxPoint x="2706" y="351" as="targetPoint"/></mxGeometry></mxCell><mxCell id="ley_l2_t" value="Relación opcional (FK NULL)" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2716" y="338" width="330" height="26" as="geometry"/></mxCell><mxCell id="ley_pk" value="PK subrayada = clave primaria · NULL = columna opcional" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2680" y="370" width="370" height="26" as="geometry"/></mxCell><mxCell id="notas" value="&lt;b&gt;Dominios (text + CHECK)&lt;/b&gt;&lt;br&gt;
• estado_funcionamiento: ABIERTO, CERRADO_TEMPORAL, CERRADO_DEFINITIVO&lt;br&gt;
• estado_publicacion: BORRADOR, PENDIENTE_REVISION, PUBLICADO&lt;br&gt;
• acceso: GRATUITO, ARANCELADO, APORTE_VOLUNTARIO, A_CONSULTAR&lt;br&gt;
• estado_geo: SIN_GEOCODIFICAR, APROXIMADA, EXACTA&lt;br&gt;
• visita_guiada.modalidad: CON_GUIA, AUTOGUIADA, CON_TURNO&lt;br&gt;
• alojamiento.estrellas: 1 a 5 (NULL si no aplica)&lt;br&gt;• motivo_estado: REFACCIONES, MANTENIMIENTO, FUERA_DE_TEMPORADA, SIN_INFORMACION&lt;br&gt;• canal_contacto.uso: GENERAL, RESERVAS, TICKETS, PROGRAMACION&lt;br&gt;• oferta.publico_admitido: PUBLICO_GENERAL, SOLO_SOCIOS, USO_INTERNO&lt;br&gt;• oferta.frecuencia: PERMANENTE, SEMANAL, MENSUAL, EVENTUAL&lt;br&gt;• salon.estado_conservacion: BUENO, REGULAR, MALO&lt;br&gt;&lt;br&gt;&lt;b&gt;Datos atómicos&lt;/b&gt;&lt;br&gt;• Sin campos de observaciones ni detalle: cada dato va en su columna, catálogo o tabla&lt;br&gt;• Único texto libre: establecimiento.descripcion (texto público de la ficha)&lt;br&gt;• canal_contacto: un valor por fila (los teléfonos separados por / se dividen)&lt;br&gt;• referente: datos internos, nunca se publican&lt;br&gt;• circuito_parada exige que la parada exista como establecimiento&lt;br&gt;&lt;br&gt;
&lt;b&gt;Reglas de integridad&lt;/b&gt;&lt;br&gt;
• canal_contacto: exactamente uno de id_establecimiento / id_oferente&lt;br&gt;
• oferta: UNIQUE (id_establecimiento, id_categoria)&lt;br&gt;
• oferta.id_categoria apunta a una categoría de primer nivel (rubro)&lt;br&gt;
• horario.id_visita, si existe, pertenece a la misma oferta&lt;br&gt;
• horario: hora_hasta &amp;gt; hora_desde&lt;br&gt;
• Índices GIST sobre lugar.punto, lugar.geometria y circuito.trazado&lt;br&gt;&lt;br&gt;&lt;b&gt;Lugares anidados (id_lugar_padre)&lt;/b&gt;&lt;br&gt;• El hijo guarda solo lo que difiere del padre; lo vacío se hereda&lt;br&gt;• CHECK: id_lugar_padre IS NOT NULL OR id_localidad IS NOT NULL&lt;br&gt;• CHECK: id_lugar_padre &amp;lt;&amp;gt; id_lugar; trigger que impide ciclos&lt;br&gt;• Vista v_lugar_resuelto (WITH RECURSIVE + COALESCE) resuelve calle, altura, localidad y punto heredados; mapa y fichas leen de ella&lt;br&gt;&lt;br&gt;&lt;b&gt;Características por rubro&lt;/b&gt;&lt;br&gt;• categoria_caracteristica define qué características ofrece el formulario para cada categoría&lt;br&gt;
&lt;br&gt;
&lt;b&gt;Auditoría&lt;/b&gt;&lt;br&gt;
• Trigger genérico auditoria.registrar() AFTER INSERT/UPDATE/DELETE en cada tabla de sicat&lt;br&gt;
• El backend informa el usuario con SET LOCAL sicat.id_usuario&lt;br&gt;
• Las tablas de negocio no llevan columnas de auditoría&lt;br&gt;
• Baja lógica con activo = false (excepto tablas puente)&lt;br&gt;&lt;br&gt;
&lt;b&gt;Vistas de solo lectura&lt;/b&gt;&lt;br&gt;
• v_mapa: un punto por oferta con rubro y categoría&lt;br&gt;
• v_ficha_publica: excluye contactos con es_publico = false" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="2680" y="420" width="420" height="1000" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>