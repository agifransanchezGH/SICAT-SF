# Copiar a .env y cambiar las contraseñas. .env no se versiona.

# PostgreSQL (superusuario del contenedor)
POSTGRES_DB=sicat
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar-postgres
DB_PORT=5432

# Usuario de la API Admin (lectura/escritura, ejecuta Flyway)
SICAT_ADMIN_DB_USER=sicat_admin_rw
SICAT_ADMIN_DB_PASSWORD=cambiar-admin

# Usuario de la API Pública (solo lectura sobre el esquema publico)
SICAT_PUBLIC_DB_USER=sicat_public_ro
SICAT_PUBLIC_DB_PASSWORD=cambiar-public

# JWT (HS256, al menos 32 caracteres)
SICAT_JWT_SECRET=cambiar-por-un-secreto-largo-de-al-menos-32-caracteres
SICAT_JWT_EXPIRACION_MINUTOS=60

# Puertos
API_ADMIN_PORT=8081
API_PUBLIC_PORT=8082
FRONT_ADMIN_PORT=4200
FRONT_PUBLIC_PORT=4300

# CORS (orígenes permitidos, separados por coma)
SICAT_ADMIN_CORS=http://localhost:4200
SICAT_PUBLIC_CORS=http://localhost:4300
